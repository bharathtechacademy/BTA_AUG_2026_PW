  "item": [
    {
      "name": "Creating a duplicate repository with valid credentials",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "//Store the repository name as a global variable every time before sending the request. \r\npm.globals.set(\"repoName\", \"PlaywrightRepo\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "//Verify the status code 422is received in the response. \r\npm.test(\"Verify status code\", function () {\r\n    pm.expect(pm.response.code).to.eql(422);\r\n});\r\n\r\n//Verify status message contains \"Unprocessable Entity\". \r\npm.test(\"Verify status message\", function () {\r\n    pm.expect(pm.response.status).to.include(\"Unprocessable Entity\");\r\n});\r\n\r\n//Verify the response body contains the key message and its value: \"repository creation failed\". \r\npm.test(\"Verify error message\", function () {\r\n    pm.expect(pm.response.json().message).to.eql(\"Repository creation failed.\");\r\n});\r\n\r\n//Verify the response body displaying the error message: \"name already exists on this account.\" \r\npm.test(\"Verify error field\", function () {\r\n    pm.expect(pm.response.json().errors[0].message).to.eql(\"name already exists on this account\");\r\n});\r\n"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/vnd.github+json"
          },
          {
            "key": "Authorization",
            "value": "{{token}}"
          },
          {
            "key": "X-GitHub-Api-Version",
            "value": "2026-03-10"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"name\":\"{{repoName}}\",\r\n    \"description\": \"Sample Duplicate Repo From Postman\",\r\n    \"private\": false\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/user/repos",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "user",
            "repos"
          ]
        }
      },
      "response": []
    },
